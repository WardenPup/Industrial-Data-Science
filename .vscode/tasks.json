{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "uv: sync",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/uv.cmd",
      "args": [
        "sync",
        "--locked"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "10.1: Herzkurve erzeugen",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/uv.cmd",
      "args": [
        "run",
        "--locked",
        "python",
        "sessions/ch10/aufgabe_10_1.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Tests: Aufgabe 10.1",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/uv.cmd",
      "args": [
        "run",
        "--locked",
        "python",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "JupyterLab",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/uv.cmd",
      "args": [
        "run",
        "--locked",
        "jupyter",
        "lab",
        "--no-browser"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Check notebook execution and exports",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/uv.cmd",
      "args": [
        "run",
        "--locked",
        "python",
        "scripts/check_notebook_tools.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
